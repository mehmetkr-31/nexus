module MultisigWalletTest where

import Daml.Script
import MultisigWallet
import Iou

-- ─────────────────────────────────────────────────────────────────────────────
-- Helpers
-- ─────────────────────────────────────────────────────────────────────────────


-- | Create a 2-of-3 wallet with alice as custodian.
-- Alice is Owner, Bob is Admin, Charlie is Signer. 
-- Wait, many existing tests assume Bob can approve governance. Let's make Alice & Bob Owners, Charlie Signer.
setup2of3 : Script (Party, Party, Party, ContractId MultisigWallet)
setup2of3 = do
  alice   <- allocateParty "Alice"
  bob     <- allocateParty "Bob"
  charlie <- allocateParty "Charlie"
  
  let aliceMember   = Member with party = alice, role = Owner
  let bobMember     = Member with party = bob, role = Owner
  let charlieMember = Member with party = charlie, role = Signer

  walletCid <- submitMulti [alice, bob, charlie] [] do
    createCmd MultisigWallet with
      walletId  = "wallet-test"
      members   = [aliceMember, bobMember, charlieMember]
      threshold = 2
      custodian = alice
  return (alice, bob, charlie, walletCid)

-- ─────────────────────────────────────────────────────────────────────────────
-- Test 1: Happy Path — 2-of-3 transfer
-- ─────────────────────────────────────────────────────────────────────────────

test2of3Transfer : Script ()
test2of3Transfer = script do
  (alice, bob, charlie, walletCid) <- setup2of3
  dave <- allocateParty "Dave"

  iouCid <- submit alice do
    createCmd Iou with
      issuer    = alice
      owner     = alice
      amount    = 1000.0
      currency  = "USD"
      observers = [bob, charlie]

  -- Alice (Owner) proposes a transfer
  proposalCid <- submit alice do
    exerciseCmd walletCid ProposeTransfer with
      proposer    = alice
      recipient   = dave
      txAmount    = 1000.0
      txCurrency  = "USD"
      description = "Payment to Dave"

  -- Charlie (Signer) approves (threshold met)
  proposalCid <- submit charlie do
    exerciseCmd proposalCid Approve with approver = charlie

  -- Alice executes the transfer
  newIouCid <- submit alice do
    exerciseCmd proposalCid Execute with
      executor  = alice
      walletCid = walletCid
      iouCid    = iouCid

  -- Verify: IOU is now owned by Dave
  Some iou <- queryContractId dave newIouCid
  assert (iou.owner == dave)
  assert (iou.amount == 1000.0)
  assert (iou.currency == "USD")

  return ()

-- ─────────────────────────────────────────────────────────────────────────────
-- Test 2: Rejection — proposal cancelled before threshold
-- ─────────────────────────────────────────────────────────────────────────────

testRejection : Script ()
testRejection = script do
  (alice, bob, charlie, walletCid) <- setup2of3
  dave <- allocateParty "Dave2"

  iouCid <- submit alice do
    createCmd Iou with
      issuer    = alice
      owner     = alice
      amount    = 500.0
      currency  = "EUR"
      observers = [bob, charlie]

  proposalCid <- submit alice do
    exerciseCmd walletCid ProposeTransfer with
      proposer    = alice
      recipient   = dave
      txAmount    = 500.0
      txCurrency  = "EUR"
      description = "Rejected payment"

  -- Bob rejects — proposal is archived
  submit bob do
    exerciseCmd proposalCid Reject with rejector = bob

  -- Verify: no active proposals remain
  proposals <- query @TransactionProposal alice
  assert (null proposals)

  return ()

-- ─────────────────────────────────────────────────────────────────────────────
-- Test 3: Insufficient approvals — execute must fail
-- ─────────────────────────────────────────────────────────────────────────────

testInsufficientApprovals : Script ()
testInsufficientApprovals = script do
  (alice, bob, charlie, walletCid) <- setup2of3
  dave <- allocateParty "Dave3"

  iouCid <- submit alice do
    createCmd Iou with
      issuer    = alice
      owner     = alice
      amount    = 100.0
      currency  = "USD"
      observers = [bob, charlie]

  proposalCid <- submit alice do
    exerciseCmd walletCid ProposeTransfer with
      proposer    = alice
      recipient   = dave
      txAmount    = 100.0
      txCurrency  = "USD"
      description = "Under-approved transfer"

  -- Only 1 approval (alice). Threshold = 2. Execute must fail.
  submitMustFail alice do
    exerciseCmd proposalCid Execute with
      executor  = alice
      walletCid = walletCid
      iouCid    = iouCid

  return ()

-- ─────────────────────────────────────────────────────────────────────────────
-- Test 4: Governance — change threshold
-- ─────────────────────────────────────────────────────────────────────────────

testChangeThreshold : Script ()
testChangeThreshold = script do
  (alice, bob, charlie, walletCid) <- setup2of3

  -- Alice (Owner) proposes changing threshold
  govCid <- submit alice do
    exerciseCmd walletCid ProposeChangeThreshold with
      proposer     = alice
      newThreshold = 3

  -- Bob (Owner) approves
  govCid <- submit bob do
    exerciseCmd govCid ApproveGovernance with approver = bob

  -- Execute governance
  result <- submit alice do
    exerciseCmd govCid ExecuteGovernance with
      executor  = alice
      walletCid = walletCid

  case result of
    Right newWalletCid -> do
      Some wallet <- queryContractId alice newWalletCid
      assert (wallet.threshold == 3)
    Left _ ->
      abort "Expected Right for ChangeThreshold"

  return ()

-- ─────────────────────────────────────────────────────────────────────────────
-- Test 5: Governance — add member
-- ─────────────────────────────────────────────────────────────────────────────

testAddMember : Script ()
testAddMember = script do
  (alice, bob, charlie, walletCid) <- setup2of3
  dave <- allocateParty "DaveNew"
  let daveMember = Member with party = dave, role = Admin

  -- Alice (Owner) proposes adding Dave
  govCid <- submit alice do
    exerciseCmd walletCid ProposeAddMember with
      proposer = alice
      newMember = daveMember

  -- Bob (Owner) approves
  govCid <- submit bob do
    exerciseCmd govCid ApproveGovernance with approver = bob

  -- Execute — returns Left (PendingWalletUpdate)
  result <- submitMulti [alice, bob, charlie] [] do
    exerciseCmd govCid ExecuteGovernance with
      executor  = alice
      walletCid = walletCid

  case result of
    Left pendingCid -> do
      -- Dave accepts membership
      newWalletCid <- submit dave do
        exerciseCmd pendingCid AcceptMembership

      Some wallet <- queryContractId dave newWalletCid
      assert (daveMember `elem` wallet.members)
      assert (length wallet.members == 4)

    Right _ ->
      abort "Expected Left for AddMember"

  return ()

-- ─────────────────────────────────────────────────────────────────────────────
-- Test 6: RBAC Enforcements
-- ─────────────────────────────────────────────────────────────────────────────

testRBAC : Script ()
testRBAC = script do
  (alice, bob, charlie, walletCid) <- setup2of3
  daveviewer <- allocateParty "DaveViewer"
  let daveMember = Member with party = daveviewer, role = Viewer

  -- 1. Alice adds Dave as Viewer
  govCid <- submit alice do
    exerciseCmd walletCid ProposeAddMember with
      proposer  = alice
      newMember = daveMember
  
  govCid <- submit bob do
    exerciseCmd govCid ApproveGovernance with approver = bob
    
  Left pendingCid <- submitMulti [alice, bob, charlie] [] do
    exerciseCmd govCid ExecuteGovernance with
      executor  = bob
      walletCid = walletCid
  
  walletCid <- submit daveviewer do
    exerciseCmd pendingCid AcceptMembership
    
  -- Now we have: Alice (Owner), Bob (Owner), Charlie (Signer), DaveViewer (Viewer)
  
  dave <- allocateParty "DaveRecipient"

  -- 2. DaveViewer tries to Propose Transfer (Must Fail)
  submitMustFail daveviewer do
    exerciseCmd walletCid ProposeTransfer with
      proposer    = daveviewer
      recipient   = dave
      txAmount    = 10.0
      txCurrency  = "USD"
      description = "Illegal Transfer"
      
  -- 3. Charlie (Signer) tries to Propose Transfer (Must Fail)
  submitMustFail charlie do
    exerciseCmd walletCid ProposeTransfer with
      proposer    = charlie
      recipient   = dave
      txAmount    = 10.0
      txCurrency  = "USD"
      description = "Illegal Transfer"

  -- 4. Alice (Owner) proposes transfer. Charlie CAN approve (Signer). DaveViewer CANNOT approve.
  proposalCid <- submit alice do
    exerciseCmd walletCid ProposeTransfer with
      proposer    = alice
      recipient   = dave
      txAmount    = 10.0
      txCurrency  = "USD"
      description = "Valid Transfer"
      
  submitMustFail daveviewer do
    exerciseCmd proposalCid Approve with approver = daveviewer
    
  proposalCid <- submit charlie do
    exerciseCmd proposalCid Approve with approver = charlie
    
  -- 5. Charlie (Signer) tries to Execute (Must Fail - needs Admin or Owner)
  iouCid <- submit alice do
    createCmd Iou with issuer = alice, owner = alice, amount = 10.0, currency = "USD", observers = [bob, charlie]
    
  submitMustFail charlie do
    exerciseCmd proposalCid Execute with
      executor  = charlie
      walletCid = walletCid
      iouCid    = iouCid

  -- 6. Alice (Owner) executes successfully
  submit alice do
    exerciseCmd proposalCid Execute with
      executor  = alice
      walletCid = walletCid
      iouCid    = iouCid

  return ()
