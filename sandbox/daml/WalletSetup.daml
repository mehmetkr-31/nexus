module WalletSetup where

import MultisigWallet (MultisigWallet(..), Member(..), partiesOf)

-- ─────────────────────────────────────────────────────────────────────────────
-- WalletInvitation
-- ─────────────────────────────────────────────────────────────────────────────

-- | An invitation for a party to join a proposed multisig wallet.
template WalletInvitation
  with
    initiator : Party
    invitee   : Member
    walletId  : Text
    allMembers: [Member]  -- ^ Full proposed member list including initiator
    threshold : Int
    custodian : Party
  where
    signatory initiator
    observer invitee.party

    -- | Accept the invitation to join the wallet.
    choice AcceptInvitation : ContractId WalletAcceptance
      controller invitee.party
      do
        create WalletAcceptance with
          walletId   = walletId
          member     = invitee
          initiator  = initiator
          allMembers = allMembers
          threshold  = threshold
          custodian  = custodian

    -- | Decline the invitation. Archives this contract.
    choice DeclineInvitation : ()
      controller invitee.party
      do return ()

    -- | Initiator can retract the invitation before it is acted on.
    choice RetractInvitation : ()
      controller initiator
      do return ()


-- ─────────────────────────────────────────────────────────────────────────────
-- WalletAcceptance
-- ─────────────────────────────────────────────────────────────────────────────

-- | Record that a party has accepted to join the wallet.
template WalletAcceptance
  with
    walletId   : Text
    member     : Member
    initiator  : Party
    allMembers : [Member]
    threshold  : Int
    custodian  : Party
  where
    signatory member.party
    observer initiator

    -- | The owner can retract their acceptance before finalization.
    choice RetractAcceptance : ()
      controller member.party
      do return ()


-- ─────────────────────────────────────────────────────────────────────────────
-- WalletFactory
-- ─────────────────────────────────────────────────────────────────────────────

template WalletFactory
  with
    initiator  : Party
    walletId   : Text
    allMembers : [Member]
    threshold  : Int
    custodian  : Party
  where
    signatory initiator
    observer (filter (/= initiator) (partiesOf allMembers))

    -- | Finalize the wallet. All non-initiator owners must authorize together.
    -- This creates MultisigWallet with all members as signatories.
    choice Finalize : ContractId MultisigWallet
      with
        acceptors : [Party]  -- ^ All non-initiator owners who accepted
      controller acceptors
      do
        let expected = filter (/= initiator) (partiesOf allMembers)
        assert (length acceptors == length expected)
        assert (all (`elem` acceptors) expected)
        create MultisigWallet with
          walletId  = walletId
          members   = allMembers
          threshold = threshold
          custodian = custodian

    -- | Initiator can cancel the factory (e.g. if someone declined).
    choice CancelFactory : ()
      controller initiator
      do return ()
