module MultisigWallet where

import DA.List (unique, find)
import Iou (Iou(..), Transfer(..))
import Daml.Script

-- ─────────────────────────────────────────────────────────────────────────────
-- Data Types
-- ─────────────────────────────────────────────────────────────────────────────

-- | Roles in the wallet. Ord allows us to check privilege levels (Owner < Admin < Signer < Viewer)
data Role = Owner | Admin | Signer | Viewer
  deriving (Eq, Show, Ord)

data Member = Member
  with
    party : Party
    role  : Role
  deriving (Eq, Show)

-- | The set of governance actions that can be proposed.
data GovernanceAction
  = AddMember Member
  | RemoveMember Party
  | ChangeThreshold Int
  deriving (Eq, Show)

-- ─────────────────────────────────────────────────────────────────────────────
-- Helpers
-- ─────────────────────────────────────────────────────────────────────────────

partiesOf : [Member] -> [Party]
partiesOf members = map (.party) members

hasRole : Party -> [Member] -> Role -> Bool
hasRole p members requiredRole = 
  case find (\m -> m.party == p) members of
    Some m -> m.role <= requiredRole
    None -> False

-- ─────────────────────────────────────────────────────────────────────────────
-- MultisigWallet
-- ─────────────────────────────────────────────────────────────────────────────

-- | A Safe.global-style M-of-N multisig wallet on Canton.
template MultisigWallet
  with
    walletId  : Text    -- ^ Unique identifier for this wallet
    members   : [Member] -- ^ The members of the wallet
    threshold : Int     -- ^ The M in M-of-N
    custodian : Party   -- ^ Owner who holds IOU assets on behalf of the wallet
  where
    signatory partiesOf members

    ensure threshold > 0
        && threshold <= length members
        && length members > 0
        && unique (partiesOf members)
        && custodian `elem` (partiesOf members)

    -- | Intermediate choice to create PendingWalletUpdate with full authority
    nonconsuming choice CreatePendingUpdate : ContractId PendingWalletUpdate
      with
        executor : Party
        newMember : Member
      controller executor
      do
        assertMsg "Executor not in wallet" (executor `elem` partiesOf members)
        assertMsg "Only Owner can add members" (hasRole executor members Owner)
        
        create PendingWalletUpdate with
          walletId        = walletId
          existingMembers = members
          newMembers      = members ++ [newMember]
          newThreshold    = threshold
          custodian       = custodian
          pendingMember   = newMember

    -- ── Transaction proposal ─────────────────────────────────────────────────

    -- | Any Member with at least Admin role can propose a transfer. 
    nonconsuming choice ProposeTransfer : ContractId TransactionProposal
      with
        proposer    : Party
        recipient   : Party
        txAmount    : Decimal
        txCurrency  : Text
        description : Text
      controller proposer
      do
        assertMsg "Proposer not in wallet" (proposer `elem` partiesOf members)
        assertMsg "Only Admin or Owner can propose transfers" (hasRole proposer members Admin)
        assertMsg "Amount must be positive" (txAmount > 0.0)
        create TransactionProposal with
          walletId        = walletId
          walletMembers   = members
          walletThreshold = threshold
          custodian       = custodian
          proposer        = proposer
          recipient       = recipient
          amount          = txAmount
          currency        = txCurrency
          description     = description
          approvers       = [proposer]

    -- | Execute an IOU transfer. Called by TransactionProposal.Execute
    nonconsuming choice ExecuteTransfer : ContractId Iou
      with
        executor  : Party
        iouCid    : ContractId Iou
        recipient : Party
      controller executor
      do
        assertMsg "Executor not in wallet" (executor `elem` partiesOf members)
        -- The authority relies on this contract being a signatory on the IOU via the custodian
        exercise iouCid Transfer with newOwner = recipient

    -- ── Governance proposals ─────────────────────────────────────────────────

    nonconsuming choice ProposeAddMember : ContractId GovernanceProposal
      with
        proposer : Party
        newMember : Member
      controller proposer
      do
        assertMsg "Proposer not in wallet" (proposer `elem` partiesOf members)
        assertMsg "Only Owner can propose adding members" (hasRole proposer members Owner)
        assertMsg "Member already exists" (newMember.party `notElem` partiesOf members)
        
        create GovernanceProposal with
          walletId      = walletId
          walletMembers = members
          threshold     = threshold
          custodian     = custodian
          proposer      = proposer
          approvers     = [proposer]
          action        = AddMember newMember

    nonconsuming choice ProposeRemoveMember : ContractId GovernanceProposal
      with
        proposer      : Party
        memberToRemove : Party
      controller proposer
      do
        assertMsg "Proposer not in wallet" (proposer `elem` partiesOf members)
        assertMsg "Only Owner can propose removing members" (hasRole proposer members Owner)
        assertMsg "Member to remove not in wallet" (memberToRemove `elem` partiesOf members)
        assertMsg "Cannot remove last member" (length members > 1)
        
        create GovernanceProposal with
          walletId      = walletId
          walletMembers = members
          threshold     = threshold
          custodian     = custodian
          proposer      = proposer
          approvers     = [proposer]
          action        = RemoveMember memberToRemove

    nonconsuming choice ProposeChangeThreshold : ContractId GovernanceProposal
      with
        proposer      : Party
        newThreshold  : Int
      controller proposer
      do
        assertMsg "Proposer not in wallet" (proposer `elem` partiesOf members)
        assertMsg "Only Owner can propose threshold changes" (hasRole proposer members Owner)
        assertMsg "Invalid threshold" (newThreshold > 0 && newThreshold <= length members)
        
        create GovernanceProposal with
          walletId      = walletId
          walletMembers = members
          threshold     = threshold
          custodian     = custodian
          proposer      = proposer
          approvers     = [proposer]
          action        = ChangeThreshold newThreshold

    -- ── Governance execution ─────────────────────────────────────────────────

    choice ExecuteGovernanceDirect : ContractId MultisigWallet
      with
        executor : Party
        action   : GovernanceAction
        newApproversCount : Int
      controller executor
      do
        assertMsg "Executor not in wallet" (executor `elem` partiesOf members)
        assertMsg "Execution needs threshold" (newApproversCount >= threshold)
        case action of
          RemoveMember partyToRemove -> do
            assertMsg "Party to remove not in wallet" (partyToRemove `elem` partiesOf members)
            let newMembers = filter (\m -> m.party /= partyToRemove) members
            let newThresh = min threshold (length newMembers)
            create this with
              members   = newMembers
              threshold = newThresh
          ChangeThreshold newThreshold -> do
            assertMsg "Invalid threshold" (newThreshold > 0 && newThreshold <= length members)
            create this with threshold = newThreshold
          AddMember _ ->
            error "Use ProposeAddMember and PendingWalletUpdate for AddMember governance"

-- ─────────────────────────────────────────────────────────────────────────────
-- TransactionProposal
-- ─────────────────────────────────────────────────────────────────────────────

template TransactionProposal
  with
    walletId        : Text
    walletMembers   : [Member]
    walletThreshold : Int
    custodian       : Party
    proposer        : Party
    recipient       : Party
    amount          : Decimal
    currency        : Text
    description     : Text
    approvers       : [Party]
  where
    signatory proposer
    observer (filter (`notElem` [proposer]) (partiesOf walletMembers))

    choice Approve : ContractId TransactionProposal
      with
        approver : Party
      controller approver
      do
        let memberParties = partiesOf walletMembers
        assertMsg "Approver not in wallet" (approver `elem` memberParties)
        assertMsg "Approver must be at least Signer" (hasRole approver walletMembers Signer)
        assertMsg "Already approved" (approver `notElem` approvers)
        create this with approvers = approvers ++ [approver]

    choice Execute : ContractId Iou
      with
        executor  : Party
        walletCid : ContractId MultisigWallet
        iouCid    : ContractId Iou
      controller executor
      do
        let memberParties = partiesOf walletMembers
        assertMsg "Executor not in wallet" (executor `elem` memberParties)
        assertMsg "Executor must be at least Admin" (hasRole executor walletMembers Admin)
        assertMsg "Threshold not met" (length approvers >= walletThreshold)
        
        iou <- fetch iouCid
        assertMsg "Custodial mismatch" (iou.owner == custodian)
        assertMsg "Amount mismatch" (iou.amount >= amount)
        assertMsg "Currency mismatch" (iou.currency == currency)
        
        exercise walletCid ExecuteTransfer with
          executor  = executor
          iouCid    = iouCid
          recipient = recipient

    choice Reject : ()
      with
        rejector : Party
      controller rejector
      do
        let memberParties = partiesOf walletMembers
        assertMsg "Rejector not in wallet" (rejector `elem` memberParties)
        assertMsg "Rejector must be at least Signer" (hasRole rejector walletMembers Signer)
        return ()

-- ─────────────────────────────────────────────────────────────────────────────
-- GovernanceProposal
-- ─────────────────────────────────────────────────────────────────────────────

template GovernanceProposal
  with
    walletId      : Text
    walletMembers : [Member]
    threshold     : Int
    custodian     : Party
    proposer      : Party
    approvers     : [Party]
    action        : GovernanceAction
  where
    signatory proposer
    observer (filter (`notElem` [proposer]) (partiesOf walletMembers))

    choice ApproveGovernance : ContractId GovernanceProposal
      with
        approver : Party
      controller approver
      do
        let memberParties = partiesOf walletMembers
        assertMsg "Approver not in wallet" (approver `elem` memberParties)
        assertMsg "Only Owner can approve governance" (hasRole approver walletMembers Owner)
        assertMsg "Already approved" (approver `notElem` approvers)
        create this with approvers = approvers ++ [approver]

    choice ExecuteGovernance : Either (ContractId PendingWalletUpdate) (ContractId MultisigWallet)
      with
        executor  : Party
        walletCid : ContractId MultisigWallet
      controller executor
      do
        let memberParties = partiesOf walletMembers
        assertMsg "Executor not in wallet" (executor `elem` memberParties)
        assertMsg "Only Owner can execute governance" (hasRole executor walletMembers Owner)
        assertMsg "Threshold not met" (length approvers >= threshold)
        
        wallet <- fetch walletCid
        case action of
          AddMember newMember -> do
            pendingCid <- exercise walletCid CreatePendingUpdate with
              executor = executor
              newMember = newMember
            return (Left pendingCid)
          RemoveMember partyToRemove -> do
            newWalletCid <- exercise walletCid ExecuteGovernanceDirect with
              executor         = executor
              action           = action
              newApproversCount = length approvers
            return (Right newWalletCid)
          ChangeThreshold newThreshold -> do
            newWalletCid <- exercise walletCid ExecuteGovernanceDirect with
              executor         = executor
              action           = action
              newApproversCount = length approvers
            return (Right newWalletCid)

    choice RejectGovernance : ()
      with
        rejector : Party
      controller rejector
      do
        let memberParties = partiesOf walletMembers
        assertMsg "Rejector not in wallet" (rejector `elem` memberParties)
        assertMsg "Only Owner can reject governance" (hasRole rejector walletMembers Owner)
        return ()

-- ─────────────────────────────────────────────────────────────────────────────
-- PendingWalletUpdate
-- ─────────────────────────────────────────────────────────────────────────────

template PendingWalletUpdate
  with
    walletId        : Text
    existingMembers : [Member]
    newMembers      : [Member]
    newThreshold    : Int
    custodian       : Party
    pendingMember   : Member
  where
    signatory partiesOf existingMembers
    observer pendingMember.party

    choice AcceptMembership : ContractId MultisigWallet
      controller pendingMember.party
      do
        create MultisigWallet with
          walletId  = walletId
          members   = newMembers
          threshold = newThreshold
          custodian = custodian

    choice CancelUpdate : ()
      controller partiesOf existingMembers
      do return ()

smokeTest : Script ()
smokeTest = script do
  debug "SMOKE TEST IN WALLET MODULE STARTING"
  alice <- allocateParty "Alice"
  return ()
